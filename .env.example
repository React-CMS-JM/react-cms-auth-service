# Template for local (.env) and production (.env.production) files.
# Copy to .env for localhost, or fill in prod values for Cloud Run / Secret Manager.
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=
# PREFERRED = local MySQL; VERIFY_IDENTITY = TiDB Cloud (CA already in JDK cacerts)
DB_SSL_MODE=PREFERRED
# Raw HMAC secret (>=32 chars). Auth signs with this; ALL 3 services need the same value
# so the container entrypoint can materialize the verify JWK. NEVER reuse local in prod.
JWT_SECRET=change-me
# Must be identical in all 3 services (content/courses verify auth's tokens)
JWT_ISSUER=
JWT_LIFESPAN=3600
# Optional override. Local: leave unset and run scripts/generate-jwt-jwk.ps1
# (writes classpath jwt-secret.jwk). Container: leave unset — entrypoint builds
# file:/tmp/jwt-secret.jwk from JWT_SECRET. Or mount a JWK and set e.g. file:/secrets/jwt.jwk
# JWT_JWK_PATH=
# Comma-separated; prod adds the frontend origin, e.g. https://your-app.web.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
HTTP_PORT=8081
